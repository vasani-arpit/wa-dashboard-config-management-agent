{
  "name": "wa-dashboard-config-management-agent",
  "main": "src/server.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ConfigurationAgent",
        "class_name": "ConfigurationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConfigurationAgent"]
    }
  ],
  "vars": {
    "GITHUB_TOKEN": "",
    "GITHUB_OWNER": "vasani-arpit",
    "GITHUB_REPO": "wa-dashboard-flags",
    "GITHUB_BRANCH": "master",
    "GEMINI_API_KEY": ""
  },
  "alias": {
    "node-fetch": "./fetch-polyfill"
  }
}